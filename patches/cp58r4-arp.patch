+ }
+ return (k+rotate)%count;
+}
+static inline uint32_t nereidaCellularNext(uint32_t cells,int selected){
+ static const uint32_t rules[4]={30u,90u,110u,150u};
+ uint32_t rule=rules[selected<0?0:selected>3?3:selected];
